# Generated by Ansible.
# Manual changes will be overwritten.

map $http_authorization $auth_ok {
    default 0;
    "Bearer {{ api_key_value }}" 1;
}

map $http_authorization $auth_ok_8443 {
    default 0;
    "Bearer {{ api_key_value_8443 }}" 1;
}

{% set chat_instances = vllm_instances
    | selectattr('name', 'equalto', nginx_openai_chat_instance)
    | list
%}

{% set embedding_instances = vllm_instances
    | selectattr('name', 'equalto', nginx_openai_embeddings_instance)
    | list
%}

{% set chat_inst = chat_instances | first %}
{% set embedding_inst = embedding_instances | first %}

# ==========================================================
# Port 443
# Each vLLM instance has its own public prefix
# ==========================================================

server {
    listen {{ nginx_listen_port }} ssl;
    server_name {{ tls_cn }};

    ssl_certificate {{ tls_crt }};
    ssl_certificate_key {{ tls_key }};

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 64m;

    access_log /var/log/nginx/vllm-{{ nginx_listen_port }}.log;
    error_log /var/log/nginx/vllm-{{ nginx_listen_port }}-error.log;

{% if nginx_health_open %}
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
{% endif %}

    location = /metrics {
        if ($auth_ok = 0) {
            return 401;
        }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_pass http://{{ vllm_upstream_host }}:{{ chat_inst.port }}/metrics;
    }

    location = / {
        if ($auth_ok = 0) {
            return 401;
        }

        return 404;
    }

{% for inst in vllm_instances %}
{% set prefix = public_prefix_map.get(inst.name, '/' ~ inst.name) %}

    # {{ inst.name }}
    location ^~ {{ prefix }}/ {
        if ($auth_ok = 0) {
            return 401;
        }

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://{{ vllm_upstream_host }}:{{ inst.port }}/;
    }

{% endfor %}
}

