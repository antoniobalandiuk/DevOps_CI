[Unit]
Description=vLLM CODA instance (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ vllm_user }}
Group={{ vllm_group }}
WorkingDirectory={{ vllm_root }}

Environment="HOME={{ vllm_home }}"
Environment="PATH={{ vllm_venv }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-{{ vllm_root }}/%i.env

ExecStart={{ vllm_bin_dir }}/vllm-launch

Restart=on-failure
RestartSec=20
TimeoutStartSec=2700
TimeoutStopSec=900
KillMode=mixed
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target


- name: verify model configuration is readable by the vLLM service user
  ansible.builtin.command:
    argv:
      - /usr/sbin/runuser
      - -u
      - "{{ vllm_user }}"
      - --
      - /usr/bin/test
      - -r
      - "{{ item.model_path }}/config.json"
  changed_when: false
  loop: "{{ vllm_instances }}"
  loop_control:
    label: "{{ item.name }}"
